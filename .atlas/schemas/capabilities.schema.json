{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-framework.local/schemas/capabilities.schema.json",
  "title": "Atlas Capabilities Schema",
  "type": "object",
  "required": [
    "version",
    "purpose",
    "agents",
    "supported_operations"
  ],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "agents": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "responsibilities",
          "decision_boundaries",
          "inputs",
          "outputs",
          "definition_of_done"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decision_boundaries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "definition_of_done": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "supported_operations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
