{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-framework.local/schemas/capabilities.schema.json",
  "title": "Atlas Capabilities Schema",
  "type": "object",
  "required": ["version", "purpose", "capabilities", "agents", "supported_operations"],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "string" },
    "purpose": { "type": "string" },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["description", "inputs", "outputs", "knowledge", "supported_roles"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "inputs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "outputs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "knowledge": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "supported_roles": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    "agents": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["config", "capabilities"],
        "properties": {
          "config": { "type": "string", "pattern": "^agents/.+\\.yaml$" },
          "capabilities": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    "supported_operations": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
