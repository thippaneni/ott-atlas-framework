{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-framework.local/schemas/rule.schema.json",
  "title": "Atlas Rule Schema",
  "type": "object",
  "required": ["rule"],
  "additionalProperties": false,
  "properties": {
    "rule": {
      "type": "object",
      "required": ["id", "name", "version", "status", "purpose", "applies_to", "requirements", "prohibited", "validation"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": { "type": "string" },
        "purpose": { "type": "string", "minLength": 1 },
        "applies_to": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "requirements": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "prohibited": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "validation": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    }
  }
}
