{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-framework.local/schemas/manifest.schema.json",
  "title": "Atlas Manifest Schema",
  "type": "object",
  "required": [
    "atlas",
    "project",
    "architecture",
    "root_files",
    "directories"
  ],
  "additionalProperties": true,
  "properties": {
    "atlas": {
      "type": "object",
      "required": [
        "name",
        "version",
        "status"
      ],
      "properties": {
        "name": {
          "const": "Atlas"
        },
        "specification": {
          "type": "string"
        },
        "acronym": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": {
          "type": "string"
        },
        "framework_type": {
          "type": "string"
        },
        "methodology": {
          "type": "string"
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "language_agnostic": {
          "type": "boolean"
        },
        "ai_provider_agnostic": {
          "type": "boolean"
        },
        "project_agnostic": {
          "type": "boolean"
        }
      }
    },
    "architecture": {
      "type": "object",
      "properties": {
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "dependency_rule": {
          "type": "string"
        }
      }
    },
    "root_files": {
      "type": "object"
    },
    "directories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "object"
    },
    "security": {
      "type": "object"
    }
  }
}
